# Arquivos e pastas de Ambiente Virtual
# Ignora a pasta do ambiente virtual para não enviar pacotes instalados
.venv/
venv/
ENV/

# Arquivos de cache e compilados do Python
# Gerados automaticamente, não precisam ser versionados
__pycache__/
*.pyc
*.pyo
*.pyd

# Checkpoints do Jupyter Notebook
# Backups automáticos criados pelo Jupyter
.ipynb_checkpoints/

# Arquivos de configuração de IDEs e editores
.idea/
.vscode/

# Arquivos de Sistema Operacional
# Arquivos de metadados do macOS e Windows
.DS_Store
Thumbs.db

# Arquivos de build e distribuição do Python
build/
dist/
*.egg-info/

